{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log-.txt", "rollingInterval": "Day" } }
    ]
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "Model": "gpt-4o"
  },
  "YouTube": {
    "ClientSecretPath": "client_secret.json",
    "ApplicationName": "AutoShortsFactory"
  },
  "Pexels": {
    "ApiKey": "YOUR_PEXELS_API_KEY"
  },
  "EdgeTts": {
    "Voice": "ko-KR-SunHiNeural",
    "PythonPath": "python"
  },
  "Paths": {
    "Output": "./output",
    "Temp": "./temp",
    "Bgm": "./bgm",
    "Fonts": "./fonts",
    "Reports": "./reports"
  },
  "Schedule": {
    "ShortsCount": 3,
    "LongFormCount": 1,
    "ShortsCron": "0 0 6,10,14 * * ?",
    "LongFormCron": "0 0 20 * * ?",
    "ReportCron": "0 0 22 * * ?",
    "RetryCron": "0 0/30 * * * ?"
  },
  "Retry": {
    "MaxRetries": 3,
    "BackoffSeconds": [ 60, 300, 900 ]
  }
}
