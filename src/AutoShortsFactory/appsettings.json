{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/autoshorts-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "Model": "gpt-4o"
  },

  "YouTube": {
    "ClientSecretPath": "client_secret.json",
    "TokenStorePath": "token_store",
    "DefaultCategoryId": "22"
  },

  "Pexels": {
    "ApiKey": "YOUR_PEXELS_API_KEY"
  },

  "FFmpeg": {
    "FFmpegPath": "ffmpeg",
    "FFprobePath": "ffprobe"
  },

  "Database": {
    "Path": "autoshorts.db"
  },

  "Workspace": {
    "RootPath": "workspace",
    "BgmDirectory": "bgm"
  },

  "Schedule": {
    "ShortsHours": [ 6, 10, 14 ],
    "LongFormHour": 20,
    "DailyReportHour": 22,
    "RetryIntervalMinutes": 30,
    "TimeZone": "Asia/Seoul"
  }
}
