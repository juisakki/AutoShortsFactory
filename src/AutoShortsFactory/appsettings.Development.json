{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Quartz": "Information"
      }
    }
  },

  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_FOR_DEV",
    "Model": "gpt-4o-mini"
  },

  "Schedule": {
    "ShortsHours": [ 6, 10, 14 ],
    "LongFormHour": 20,
    "DailyReportHour": 22,
    "RetryIntervalMinutes": 30,
    "TimeZone": "Asia/Seoul"
  }
}
